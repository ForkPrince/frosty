<?xml version="1.0" encoding="utf-8"?>
<!-- TTVLOLv2 only: the in-app loopback playlist proxy serves HLS playlists
     from http://127.0.0.1 (see TtvLolV2LocalProxy). Android 9+ blocks
     cleartext HTTP by default, which would make ExoPlayer fail to load
     that loopback URL with "Cleartext HTTP traffic not permitted".
     This permits cleartext ONLY to 127.0.0.1; every other host keeps the
     default policy (cleartext denied). It is intentionally narrower than
     android:usesCleartextTraffic="true", which would allow cleartext
     anywhere. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
